<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>UpdateForge.Desktop</RootNamespace>
    <AssemblyName>updateforge</AssemblyName>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CA1001;CA1822</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\UpdateForge.Infrastructure\UpdateForge.Infrastructure.csproj" />
    <ProjectReference Include="..\UpdateForge.Background\UpdateForge.Background.csproj" />
    <ProjectReference Include="..\UpdateForge.Providers.Linux\UpdateForge.Providers.Linux.csproj" />
    <ProjectReference Include="..\UpdateForge.Providers.Npm\UpdateForge.Providers.Npm.csproj" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shared with the WPF app: these view models have no WPF dependency. -->
    <Compile Include="..\UpdateForge.Desktop\ViewModels\AppRowViewModel.cs" Link="ViewModels\Shared\AppRowViewModel.cs" />
    <Compile Include="..\UpdateForge.Desktop\ViewModels\HistoryViewModel.cs" Link="ViewModels\Shared\HistoryViewModel.cs" />
    <Compile Include="..\UpdateForge.Desktop\ViewModels\PackageDetailsViewModel.cs" Link="ViewModels\Shared\PackageDetailsViewModel.cs" />
    <AvaloniaResource Include="..\UpdateForge.Desktop\Assets\UpdateForge-512.png" Link="Assets\UpdateForge-512.png" />
  </ItemGroup>
</Project>
