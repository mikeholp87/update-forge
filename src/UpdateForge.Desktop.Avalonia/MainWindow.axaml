<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:UpdateForge.Desktop.Views"
        xmlns:vm="using:UpdateForge.Desktop.ViewModels"
        x:Class="UpdateForge.Desktop.MainWindow"
        Icon="/Assets/UpdateForge-512.png"
        Title="UpdateForge" Width="1180" Height="760" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Grid ColumnDefinitions="216,*">
        <Border Grid.Column="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="20,22,20,22">
                    <Image Source="/Assets/UpdateForge-512.png" Width="26" Height="26" />
                    <TextBlock Text="UpdateForge" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,0,12,0" Spacing="2">
                    <Button Classes="nav" Classes.active="{Binding IsDashboardPage}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:PageId.Dashboard}" Content="Dashboard" />
                    <Button Classes="nav" Classes.active="{Binding IsApplicationsPage}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:PageId.Applications}" Content="Installed" />
                    <Button Classes="nav" Classes.active="{Binding IsDiscoverPage}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:PageId.Discover}" Content="Discover" />
                    <Button Classes="nav" Classes.active="{Binding IsRecommendationsPage}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:PageId.Recommendations}" Content="Recommended" />
                    <Button Classes="nav" Classes.active="{Binding IsQueuePage}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:PageId.Queue}" Content="Queue" Margin="0,16,0,0" />
                    <Button Classes="nav" Classes.active="{Binding IsHistoryPage}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:PageId.History}" Content="History" />
                    <Button Classes="nav" Classes.active="{Binding IsManagersPage}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:PageId.PackageManagers}" Content="Package managers" Margin="0,16,0,0" />
                    <Button Classes="nav" Classes.active="{Binding IsSettingsPage}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:PageId.Settings}" Content="Settings" />
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="20,12,20,20" Spacing="8">
                    <ProgressBar IsIndeterminate="True" Height="2" IsVisible="{Binding IsBusy}" />
                    <Button Classes="accent" Content="Scan now" Command="{Binding ScanCommand}" IsEnabled="{Binding IsIdle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="40,32,40,24">
            <views:DashboardView IsVisible="{Binding IsDashboardPage}" />
            <views:ApplicationsView IsVisible="{Binding IsApplicationsPage}" />
            <views:DiscoverView DataContext="{Binding DiscoverPage}" IsVisible="{Binding $parent[Window].DataContext.IsDiscoverPage}" />
            <views:RecommendationsView DataContext="{Binding RecommendationsPage}" IsVisible="{Binding $parent[Window].DataContext.IsRecommendationsPage}" />
            <views:QueueView IsVisible="{Binding IsQueuePage}" />
            <views:HistoryView DataContext="{Binding HistoryPage}" IsVisible="{Binding $parent[Window].DataContext.IsHistoryPage}" />
            <views:PackageManagersView DataContext="{Binding PackageManagersPage}" IsVisible="{Binding $parent[Window].DataContext.IsManagersPage}" />
            <views:SettingsView DataContext="{Binding SettingsPage}" IsVisible="{Binding $parent[Window].DataContext.IsSettingsPage}" />
        </Grid>
    </Grid>
</Window>
