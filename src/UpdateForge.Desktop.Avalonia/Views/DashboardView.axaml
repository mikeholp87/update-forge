<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UpdateForge.Desktop.ViewModels"
             x:Class="UpdateForge.Desktop.Views.DashboardView">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
        <StackPanel Grid.Row="0">
            <TextBlock Classes="title" Text="System software status" />
            <TextBlock Classes="muted"><Run Text="Last scan: " /><Run Text="{Binding LastScanText}" /><Run Text="   ·   " /><Run Text="{Binding AutomaticText}" /></TextBlock>
        </StackPanel>

        <UniformGrid Grid.Row="1" Rows="1" Columns="5" Margin="0,16,0,0">
            <Border Classes="card" Margin="0,0,8,0"><StackPanel><TextBlock Classes="stat" Text="{Binding InstalledCount}" /><TextBlock Classes="muted" Text="Installed applications" TextWrapping="Wrap" /></StackPanel></Border>
            <Border Classes="card" Margin="0,0,8,0"><StackPanel><TextBlock Classes="stat" Text="{Binding UpdatesCount}" Foreground="DodgerBlue" /><TextBlock Classes="muted" Text="Updates available" TextWrapping="Wrap" /></StackPanel></Border>
            <Border Classes="card" Margin="0,0,8,0"><StackPanel><TextBlock Classes="stat" Text="{Binding UpToDateCount}" Foreground="SeaGreen" /><TextBlock Classes="muted" Text="Up to date" TextWrapping="Wrap" /></StackPanel></Border>
            <Border Classes="card" Margin="0,0,8,0"><StackPanel><TextBlock Classes="stat" Text="{Binding AttentionCount}" Foreground="DarkOrange" /><TextBlock Classes="muted" Text="Requires attention" TextWrapping="Wrap" /></StackPanel></Border>
            <Border Classes="card"><StackPanel><TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding LastSuccessText}" TextWrapping="Wrap" /><TextBlock Classes="muted" Text="Last successful update" TextWrapping="Wrap" /></StackPanel></Border>
        </UniformGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
            <Button Classes="accent" Content="Scan now" Command="{Binding ScanCommand}" IsEnabled="{Binding IsIdle}" />
            <Button Content="Update all" Command="{Binding UpdateAllCommand}" IsEnabled="{Binding IsIdle}" />
            <Button Content="Schedule updates" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:PageId.Settings}" />
            <Button Content="View history" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:PageId.History}" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,12,0,0" Spacing="6">
            <ProgressBar Value="{Binding OverallProgress}" IsIndeterminate="{Binding OverallIndeterminate}" Maximum="100" Height="4" IsVisible="{Binding IsBusy}" />
            <TextBlock Classes="muted" Text="{Binding Status}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ProviderNotice}" Foreground="DarkOrange" TextWrapping="Wrap" IsVisible="{Binding ProviderNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Text="{Binding RestartNotice}" Foreground="DodgerBlue" TextWrapping="Wrap" IsVisible="{Binding RestartNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>

        <DockPanel Grid.Row="4" Margin="0,16,0,0">
            <TextBlock DockPanel.Dock="Top" Classes="heading" Text="Available updates" Margin="0,0,0,8" />
            <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="0,0,0,8" TextWrapping="Wrap"
                       Text="Everything UpdateForge can update is up to date. Use Scan now to check again."
                       IsVisible="{Binding NoUpdatesNotice}" />
            <DataGrid ItemsSource="{Binding PendingUpdates}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="None" CanUserSortColumns="True" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Application" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="Installed" Binding="{Binding Installed}" Width="*" />
                    <DataGridTextColumn Header="Available" Binding="{Binding Available}" Width="*" />
                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="*" />
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="*" />
                    <DataGridTemplateColumn Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Update" Classes="accent" Padding="12,3" IsVisible="{Binding CanUpdate}"
                                        Command="{Binding $parent[UserControl].DataContext.UpdateOneCommand}" CommandParameter="{Binding}"
                                        IsEnabled="{Binding $parent[UserControl].DataContext.IsIdle}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
