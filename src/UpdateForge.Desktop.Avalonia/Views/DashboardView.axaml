<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UpdateForge.Desktop.ViewModels"
             xmlns:conv="using:UpdateForge.Desktop.Converters"
             x:Class="UpdateForge.Desktop.Views.DashboardView">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
        <!-- The answer first: does anything need me? -->
        <StackPanel Grid.Row="0" Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="14">
                <Ellipse Width="12" Height="12" VerticalAlignment="Center" Margin="0,8,0,0" Fill="{DynamicResource Warn}" IsVisible="{Binding HasUpdates}" />
                <TextBlock Classes="headline" Text="{Binding Headline}" />
            </StackPanel>
            <TextBlock Classes="muted" Text="{Binding Subline}" />
            <TextBlock Text="{Binding AttentionText}" Foreground="{DynamicResource Warn}" IsVisible="{Binding AttentionText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Classes="muted" Text="{Binding Status}" IsVisible="{Binding IsBusy}" />
            <TextBlock Text="{Binding ProviderNotice}" Foreground="{DynamicResource Bad}" TextWrapping="Wrap" IsVisible="{Binding ProviderNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Text="{Binding RestartNotice}" Foreground="{DynamicResource Warn}" TextWrapping="Wrap" IsVisible="{Binding RestartNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0" IsVisible="{Binding HasUpdates}">
                <Button Classes="accent" Content="Update all" Command="{Binding UpdateAllCommand}" IsEnabled="{Binding IsIdle}" />
                <Button Content="Review in Installed" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:PageId.Applications}" />
            </StackPanel>
        </StackPanel>

        <!-- Where your software comes from: one bar, split by manager. Segments are built in code-behind (proportional widths). -->
        <Grid x:Name="Bar" Grid.Row="1" Height="8" Margin="0,32,0,16" />

        <ItemsControl Grid.Row="2" ItemsSource="{Binding Providers}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Grid ColumnDefinitions="22,*,Auto,140" Height="40">
                            <Ellipse Grid.Column="0" Width="9" Height="9" Fill="{Binding Brush}" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Medium" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Count, StringFormat='{}{0} packages'}" Classes="muted" VerticalAlignment="Center" Margin="0,0,24,0" />
                            <TextBlock Grid.Column="3" Text="{Binding PendingText}" HorizontalAlignment="Right" VerticalAlignment="Center" Classes="muted" Classes.pending="{Binding HasPending}" />
                        </Grid>
                        <Border Classes="rule" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Only when there is something to act on. -->
        <DockPanel Grid.Row="4" Margin="0,28,0,0" IsVisible="{Binding HasUpdates}">
            <TextBlock DockPanel.Dock="Top" Classes="heading" Text="Ready to update" Margin="0,0,0,8" />
            <DataGrid ItemsSource="{Binding PendingUpdates}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="Installed" Binding="{Binding Installed}" Width="*" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                    <DataGridTextColumn Header="Available" Binding="{Binding Available}" Width="*" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                    <DataGridTextColumn Header="Manager" Binding="{Binding App.ProviderId}" Width="*" />
                    <DataGridTemplateColumn Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Update" Classes="quiet" IsVisible="{Binding CanUpdate}" Foreground="{DynamicResource Accent}"
                                        Command="{Binding $parent[UserControl].DataContext.UpdateOneCommand}" CommandParameter="{Binding}"
                                        IsEnabled="{Binding $parent[UserControl].DataContext.IsIdle}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
