<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UpdateForge.Desktop.Views.HistoryView">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock Grid.Row="0" Classes="title" Text="Update history" />
        <TextBox Grid.Row="1" Watermark="Search history" Text="{Binding Search, Mode=TwoWay}" Margin="0,12,0,12" />
        <DataGrid Grid.Row="2" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Application" Binding="{Binding ApplicationName}" Width="2*" />
                <DataGridTextColumn Header="Previous" Binding="{Binding PreviousVersion}" Width="*" />
                <DataGridTextColumn Header="Requested" Binding="{Binding RequestedVersion}" Width="*" />
                <DataGridTextColumn Header="Result" Binding="{Binding FinalState}" Width="*" />
                <DataGridTextColumn Header="Date" Binding="{Binding CompletedAt, StringFormat=g}" Width="*" />
                <DataGridTextColumn Header="Duration" Binding="{Binding Duration, StringFormat=mm\\:ss}" Width="*" />
                <DataGridTextColumn Header="Provider" Binding="{Binding ProviderId}" Width="*" />
                <DataGridTextColumn Header="Exit code" Binding="{Binding ExitCode}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
        <Border Grid.Row="3" Classes="panel" Margin="0,12,0,0" DataContext="{Binding Selected}" IsVisible="{Binding Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                <TextBlock Classes="muted" Text="{Binding TechnicalDetails}" TextWrapping="Wrap" FontFamily="monospace" FontSize="12" MaxHeight="120" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
