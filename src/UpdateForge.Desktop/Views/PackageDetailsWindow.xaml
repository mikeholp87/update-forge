<ui:FluentWindow x:Class="UpdateForge.Desktop.Views.PackageDetailsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{Binding Title, StringFormat='{}{0} – package details'}"
                 Width="680" Height="620" MinWidth="460" MinHeight="380"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
                 AutomationProperties.Name="Package details">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="Package details" ShowMinimize="False" ShowMaximize="False" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,8,24,8">
            <StackPanel>
                <TextBlock Text="{Binding Row.Name}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <Run Text="{Binding Row.PackageId, Mode=OneWay}" />
                    <Run Text="·" />
                    <Run Text="{Binding Row.Version, Mode=OneWay}" />
                    <Run Text="·" />
                    <Run Text="{Binding Row.Manager, Mode=OneWay}" />
                    <Run Text="·" />
                    <Run Text="{Binding Row.Source, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Margin="0,4,0,0" Text="{Binding Row.Status}" FontWeight="SemiBold"
                           Visibility="{Binding Row.Status, Converter={StaticResource StringToVisibility}}" />

                <ProgressBar Height="3" IsIndeterminate="True" Margin="0,16,0,0"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Margin="0,12,0,0" Text="{Binding Message}" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"
                           Visibility="{Binding Message, Converter={StaticResource StringToVisibility}}" />

                <TextBox Margin="0,16,0,0" Text="{Binding Description, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                         BorderThickness="0" Background="Transparent" Padding="0"
                         AutomationProperties.Name="Package description"
                         Visibility="{Binding Description, Converter={StaticResource StringToVisibility}}" />

                <ui:HyperlinkButton Margin="-8,8,0,0" Padding="8,4" Command="{Binding OpenHomepageCommand}"
                                    Content="{Binding Homepage.AbsoluteUri}" ToolTip="Open the package homepage in your browser"
                                    AutomationProperties.Name="Open package homepage"
                                    Visibility="{Binding HasHomepage, Converter={StaticResource BoolToVisibility}}" />

                <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding Fields}" AutomationProperties.Name="Package details">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" Margin="0,0,12,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                         BorderThickness="0" Background="Transparent" Padding="0" MinHeight="0"
                                         AutomationProperties.Name="{Binding Name}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="Details come from the package manager's catalog and are not reviewed by UpdateForge." />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="24,12" Background="{DynamicResource ControlFillColorSecondaryBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Install" Appearance="Primary" Margin="0,0,8,0" Command="{Binding InstallCommand}"
                           Visibility="{Binding ShowInstall, Converter={StaticResource BoolToVisibility}}"
                           AutomationProperties.Name="{Binding Row.Name, StringFormat='Install {0}'}" />
                <ui:Button Content="Close" IsCancel="True" Click="Close_Click" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
