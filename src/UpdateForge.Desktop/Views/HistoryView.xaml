<UserControl x:Class="UpdateForge.Desktop.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" Text="Update history" />
        <ui:TextBox Grid.Row="1" PlaceholderText="Search history" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Icon="{ui:SymbolIcon Search24}"
                    Margin="0,12,0,12" AutomationProperties.Name="Search history" />
        <DataGrid Grid.Row="2" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="None" CanUserAddRows="False" AutomationProperties.Name="Update history list">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Application" Binding="{Binding ApplicationName}" Width="2*" />
                <DataGridTextColumn Header="Previous" Binding="{Binding PreviousVersion}" Width="*" />
                <DataGridTextColumn Header="Requested" Binding="{Binding RequestedVersion}" Width="*" />
                <DataGridTextColumn Header="Result" Binding="{Binding FinalState}" Width="*" />
                <DataGridTextColumn Header="Date" Binding="{Binding CompletedAt, StringFormat=g}" Width="*" />
                <DataGridTextColumn Header="Duration" Binding="{Binding Duration, StringFormat=mm\\:ss}" Width="*" />
                <DataGridTextColumn Header="Provider" Binding="{Binding ProviderId}" Width="*" />
                <DataGridTextColumn Header="Exit code" Binding="{Binding ExitCode}" Width="*" />
                <DataGridCheckBoxColumn Header="Restart" Binding="{Binding RestartRequired, Mode=OneWay}" Width="70" />
            </DataGrid.Columns>
        </DataGrid>
        <ui:Card Grid.Row="3" Margin="0,12,0,0" DataContext="{Binding Selected}" Visibility="{Binding Message, Converter={StaticResource StringToVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding TechnicalDetails}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" MaxHeight="120"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" />
            </StackPanel>
        </ui:Card>
    </Grid>
</UserControl>
