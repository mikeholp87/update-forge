<UserControl x:Class="UpdateForge.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:UpdateForge.Desktop.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource PageTitle}" Text="System software status" />
            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                <Run Text="Last scan:" /> <Run Text="{Binding LastScanText, Mode=OneWay}" />
                <Run Text="   ·   " /> <Run Text="{Binding AutomaticText, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>

        <UniformGrid Grid.Row="1" Rows="1" Columns="5" Margin="0,16,0,0">
            <ui:Card Margin="0,0,8,0" AutomationProperties.Name="Installed applications count">
                <StackPanel><TextBlock Style="{StaticResource StatNumber}" Text="{Binding InstalledCount}" /><TextBlock Style="{StaticResource StatLabel}" Text="Installed applications" TextWrapping="Wrap" /></StackPanel>
            </ui:Card>
            <ui:Card Margin="0,0,8,0" AutomationProperties.Name="Updates available count">
                <StackPanel><TextBlock Style="{StaticResource StatNumber}" Text="{Binding UpdatesCount}" Foreground="{DynamicResource SystemFillColorAttentionBrush}" /><TextBlock Style="{StaticResource StatLabel}" Text="Updates available" TextWrapping="Wrap" /></StackPanel>
            </ui:Card>
            <ui:Card Margin="0,0,8,0" AutomationProperties.Name="Up to date count">
                <StackPanel><TextBlock Style="{StaticResource StatNumber}" Text="{Binding UpToDateCount}" Foreground="{DynamicResource SystemFillColorSuccessBrush}" /><TextBlock Style="{StaticResource StatLabel}" Text="Up to date" TextWrapping="Wrap" /></StackPanel>
            </ui:Card>
            <ui:Card Margin="0,0,8,0" AutomationProperties.Name="Requires attention count">
                <StackPanel><TextBlock Style="{StaticResource StatNumber}" Text="{Binding AttentionCount}" Foreground="{DynamicResource SystemFillColorCautionBrush}" /><TextBlock Style="{StaticResource StatLabel}" Text="Requires attention" TextWrapping="Wrap" /></StackPanel>
            </ui:Card>
            <ui:Card AutomationProperties.Name="Last successful update">
                <StackPanel><TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding LastSuccessText}" TextWrapping="Wrap" /><TextBlock Style="{StaticResource StatLabel}" Text="Last successful update" TextWrapping="Wrap" /></StackPanel>
            </ui:Card>
        </UniformGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
            <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon ArrowSync24}" Content="Scan now" Command="{Binding ScanCommand}"
                       IsEnabled="{Binding IsIdle}" Margin="0,0,8,0" AutomationProperties.Name="Scan now" />
            <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon ArrowDownload24}" Content="Update all" Command="{Binding UpdateAllCommand}"
                       IsEnabled="{Binding IsIdle}" Margin="0,0,8,0" AutomationProperties.Name="Update all" />
            <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Clock24}" Content="Schedule updates" Command="{Binding NavigateCommand}"
                       CommandParameter="{x:Static vm:PageId.Settings}" Margin="0,0,8,0" AutomationProperties.Name="Schedule updates" />
            <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon History24}" Content="View history" Command="{Binding NavigateCommand}"
                       CommandParameter="{x:Static vm:PageId.History}" AutomationProperties.Name="View history" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <ProgressBar Value="{Binding OverallProgress}" IsIndeterminate="{Binding OverallIndeterminate}" Maximum="100" Height="4"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding Status}" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
            <ui:InfoBar Severity="Warning" IsOpen="True" IsClosable="False" Title="Some providers had problems" Message="{Binding ProviderNotice}" Margin="0,8,0,0"
                        Visibility="{Binding ProviderNotice, Converter={StaticResource StringToVisibility}}" />
            <ui:InfoBar Severity="Informational" IsOpen="True" IsClosable="False" Title="Restart required" Message="{Binding RestartNotice}" Margin="0,8,0,0"
                        Visibility="{Binding RestartNotice, Converter={StaticResource StringToVisibility}}" />
        </StackPanel>

        <DockPanel Grid.Row="4" Margin="0,16,0,0">
            <TextBlock DockPanel.Dock="Top" FontSize="18" FontWeight="SemiBold" Text="Available updates" Margin="0,0,0,8" />
            <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="Text" Value="Everything UpdateForge can update is up to date. Use Scan now to check again." />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding UpdatesCount}" Value="0" />
                                    <Condition Binding="{Binding IsBusy}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <DataGrid ItemsSource="{Binding PendingUpdates}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      GridLinesVisibility="None" CanUserAddRows="False" SelectionMode="Single" AutomationProperties.Name="Available updates">
                <DataGrid.RowStyle>
                    <!-- Must build on WPF-UI's own row style; the generic {x:Type DataGridRow} style is the light Windows default (white rows). -->
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource DefaultDataGridRowStyle}">
                        <!-- Tag carries the view model so the (visual-tree-less) context menu can reach its commands. -->
                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu>
                                    <MenuItem Header="Update"
                                              Command="{Binding PlacementTarget.Tag.UpdateOneCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}"
                                              IsEnabled="{Binding CanUpdate}" />
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Application" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="Installed" Binding="{Binding Installed}" Width="*" />
                    <DataGridTextColumn Header="Available" Binding="{Binding Available}" Width="*" />
                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="*" />
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="*" />
                    <DataGridTemplateColumn Header="" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ui:Button Content="Update" Appearance="Primary" Padding="12,3"
                                           Command="{Binding DataContext.UpdateOneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"
                                           IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           Visibility="{Binding CanUpdate, Converter={StaticResource BoolToVisibility}}"
                                           AutomationProperties.Name="{Binding Name, StringFormat='Update {0}'}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
