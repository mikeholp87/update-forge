<UserControl x:Class="UpdateForge.Desktop.Views.RecommendationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <!-- One row for both packages and tips: what it is, why it fits, how to use it, and what you can do about it. -->
        <DataTemplate x:Key="Row">
            <StackPanel>
                <Grid Margin="0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,24,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Title}" />
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Bottom" Text="{Binding Meta}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Margin="0,4,0,0" Text="{Binding Why}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding Tip}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding HasTip, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding Because}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Visibility="{Binding HasBecause, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Width="140" VerticalAlignment="Top">
                        <ui:Button Content="Install" Appearance="Primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                   Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" IsEnabled="{Binding CanInstall}"
                                   Visibility="{Binding IsPackage, Converter={StaticResource BoolToVisibility}}"
                                   AutomationProperties.Name="{Binding Title, StringFormat='Install {0}'}" />
                        <ui:Button Content="Not interested" Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,4,0,0"
                                   Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" Visibility="{Binding IsPackage, Converter={StaticResource BoolToVisibility}}"
                                   AutomationProperties.Name="{Binding Title, StringFormat='Not interested in {0}'}" />
                        <ui:Button Content="Hide this tip" Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                   Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" Visibility="{Binding IsTip, Converter={StaticResource BoolToVisibility}}"
                                   AutomationProperties.Name="{Binding Title, StringFormat='Hide tip: {0}'}" />
                    </StackPanel>
                </Grid>
                <Separator Opacity="0.4" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,12,0">
            <TextBlock Style="{StaticResource PageTitle}" Text="Recommended for you" />
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       AutomationProperties.LiveSetting="Polite" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,8">
                <ui:Button Content="Refresh" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RefreshCommand}"
                           IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}" Margin="0,0,8,0"
                           AutomationProperties.Name="Refresh recommendations" />
                <ui:Button Content="{Binding RestoreText}" Appearance="Transparent" Command="{Binding RestoreDismissedCommand}"
                           Visibility="{Binding HasDismissed, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

            <!-- What it has learned: visible, switchable and erasable. -->
            <ui:Card Margin="0,8,0,8">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding LearnedText}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Interests}" Margin="0,8,0,0"
                                  Visibility="{Binding HasInterests, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                                    <TextBlock Grid.Column="1" Text="{Binding Strength}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <CheckBox Content="Learn from what I install" IsChecked="{Binding LearnEnabled}" Margin="0,0,16,0"
                                  AutomationProperties.Name="Learn from what I install" />
                        <ui:Button Content="Forget what it learned" Appearance="Transparent" Command="{Binding ForgetCommand}" />
                    </StackPanel>
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="Learned on this computer only, from the apps you install and the suggestions you accept or turn down. It fades over a few months and is never sent anywhere." />
                </StackPanel>
            </ui:Card>

            <ItemsControl ItemsSource="{Binding Packages}" ItemTemplate="{StaticResource Row}" />

            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Tips for your setup" Margin="0,24,0,0"
                       Visibility="{Binding HasTips, Converter={StaticResource BoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding Tips}" ItemTemplate="{StaticResource Row}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
