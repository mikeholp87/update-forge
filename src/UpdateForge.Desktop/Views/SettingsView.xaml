<UserControl x:Class="UpdateForge.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="Settings" />

            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Updates" Margin="0,16,0,8" />
            <ui:Card>
                <StackPanel>
                    <TextBlock Text="Installation mode" />
                    <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" Margin="0,4,0,4" AutomationProperties.Name="Installation mode" />
                    <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Manual: check only, install when you click. AutomaticSafe: scheduled runs install only supported, non-interactive, non-elevated updates and leave everything else pending. Updates that need administrator rights are never installed unattended." />
                    <CheckBox Content="Allow automatic updates on battery power" IsChecked="{Binding RunOnBattery}" Margin="0,12,0,0" />
                    <CheckBox Content="Allow automatic updates on metered connections" IsChecked="{Binding RunOnMetered}" />
                </StackPanel>
            </ui:Card>

            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Scanning and schedule" Margin="0,16,0,8" />
            <ui:Card>
                <StackPanel>
                    <TextBlock Text="Check interval" />
                    <ComboBox ItemsSource="{Binding Intervals}" SelectedItem="{Binding Interval}" Margin="0,4,0,8" AutomationProperties.Name="Check interval" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Custom interval (hours):" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ui:NumberBox Value="{Binding CustomHours}" Minimum="1" Maximum="720" Width="120" AutomationProperties.Name="Custom interval in hours" />
                    </StackPanel>
                    <CheckBox Content="Check for updates when UpdateForge starts" IsChecked="{Binding CheckAtStartup}" />
                    <TextBlock Text="Choose enabled providers and manage sources on the Package managers page." Margin="0,8,0,4" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ScheduleText}" Margin="0,12,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="The scheduled task runs as you, only while you are signed in, without elevated privileges. It works even when this window is closed." />
                </StackPanel>
            </ui:Card>

            <TextBlock FontSize="18" FontWeight="SemiBold" Text="General" Margin="0,16,0,8" />
            <ui:Card>
                <StackPanel>
                    <TextBlock Text="Theme" />
                    <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" Margin="0,4,0,8" AutomationProperties.Name="Theme" />
                    <CheckBox Content="Minimize to the system tray" IsChecked="{Binding MinimizeToTray}" />
                    <CheckBox Content="Close button hides to the system tray" IsChecked="{Binding CloseToTray}" />
                </StackPanel>
            </ui:Card>

            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Notifications" Margin="0,16,0,8" />
            <ui:Card>
                <StackPanel>
                    <CheckBox Content="New updates available" IsChecked="{Binding NotifyNew}" />
                    <CheckBox Content="Updates completed" IsChecked="{Binding NotifyCompleted}" />
                    <CheckBox Content="Updates failed" IsChecked="{Binding NotifyFailed}" />
                    <CheckBox Content="Restart required" IsChecked="{Binding NotifyRestart}" />
                </StackPanel>
            </ui:Card>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <ui:Button Appearance="Primary" Content="Save settings" Command="{Binding SaveCommand}" Margin="0,0,8,0" AutomationProperties.Name="Save settings" />
                <ui:Button Content="Remove scheduled task" Command="{Binding RemoveScheduleCommand}" AutomationProperties.Name="Remove scheduled task" />
            </StackPanel>
            <TextBlock Text="{Binding SaveMessage}" Margin="0,8,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />

            <TextBlock FontSize="18" FontWeight="SemiBold" Text="About" Margin="0,24,0,8" />
            <ui:Card>
                <StackPanel>
                    <TextBlock><Run Text="UpdateForge " /><Run Text="{Binding Version, Mode=OneWay}" /></TextBlock>
                    <TextBlock Text="Free and open source under the MIT License. No telemetry, no accounts, no ads." Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
