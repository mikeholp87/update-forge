<UserControl x:Class="UpdateForge.Desktop.Views.ApplicationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" Text="Installed applications" />

        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Grid.Column="0" PlaceholderText="Search applications" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                        Icon="{ui:SymbolIcon Search24}" Margin="0,0,8,0" AutomationProperties.Name="Search applications" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" Margin="0,0,8,0" AutomationProperties.Name="Filter applications" />
            <ui:DropDownButton Grid.Column="2" Content="Export / import" Icon="{ui:SymbolIcon ArrowSwap24}" Margin="0,0,8,0"
                               Tag="{Binding}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="Export and import">
                <ui:DropDownButton.Flyout>
                    <ContextMenu>
                        <MenuItem Header="Export this list to CSV…" AutomationProperties.Name="Export this list to CSV"
                                  Command="{Binding PlacementTarget.Tag.ExportCsvCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="Export package bundle…" AutomationProperties.Name="Export package bundle"
                                  Command="{Binding PlacementTarget.Tag.ExportBundleCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="Import package bundle…" AutomationProperties.Name="Import package bundle"
                                  Command="{Binding PlacementTarget.Tag.ImportBundleCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </ui:DropDownButton.Flyout>
            </ui:DropDownButton>
            <ui:Button Grid.Column="3" Appearance="Primary" Content="Update checked" Icon="{ui:SymbolIcon ArrowDownload24}"
                       Command="{Binding UpdateCheckedCommand}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="Update checked applications" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" ItemsSource="{Binding AppsView}" SelectedItem="{Binding Selected, Mode=TwoWay}" AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserSortColumns="True" HeadersVisibility="Column" GridLinesVisibility="None"
                      SelectionMode="Single" Margin="0,0,12,0" AutomationProperties.Name="Installed applications list">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource DefaultDataGridRowStyle}">
                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu>
                                    <MenuItem Header="Update"
                                              Command="{Binding PlacementTarget.Tag.UpdateOneCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}"
                                              IsEnabled="{Binding CanUpdate}" />
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="" Binding="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" Width="36" SortMemberPath="IsChecked" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" IsReadOnly="True" Width="2*" />
                    <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" IsReadOnly="True" Width="*" />
                    <DataGridTextColumn Header="Installed" Binding="{Binding Installed}" IsReadOnly="True" Width="*" />
                    <DataGridTextColumn Header="Available" Binding="{Binding Available}" IsReadOnly="True" Width="*" />
                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" IsReadOnly="True" Width="*" />
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" IsReadOnly="True" Width="*" />
                    <DataGridTextColumn Header="Last checked" Binding="{Binding LastChecked}" IsReadOnly="True" Width="*" />
                    <DataGridTemplateColumn Header="" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ui:Button Content="Update" Appearance="Primary" Padding="12,3"
                                           Command="{Binding DataContext.UpdateOneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}"
                                           IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           Visibility="{Binding CanUpdate, Converter={StaticResource BoolToVisibility}}"
                                           AutomationProperties.Name="{Binding Name, StringFormat='Update {0}'}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <ui:Card Grid.Column="1" DataContext="{Binding Selected}" VerticalAlignment="Top" AutomationProperties.Name="Application details">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Publisher}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,12" />
                    <TextBlock Text="Details" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap"><Run Text="Installed: " /><Run Text="{Binding Installed, Mode=OneWay}" /></TextBlock>
                    <TextBlock TextWrapping="Wrap"><Run Text="Available: " /><Run Text="{Binding Available, Mode=OneWay}" /></TextBlock>
                    <TextBlock TextWrapping="Wrap"><Run Text="Source: " /><Run Text="{Binding Source, Mode=OneWay}" /></TextBlock>
                    <TextBlock TextWrapping="Wrap"><Run Text="Scope: " /><Run Text="{Binding Scope, Mode=OneWay}" /></TextBlock>
                    <TextBlock TextWrapping="Wrap"><Run Text="Identification confidence: " /><Run Text="{Binding Confidence, Mode=OneWay}" /></TextBlock>
                    <TextBlock TextWrapping="Wrap"><Run Text="Status: " /><Run Text="{Binding StatusText, Mode=OneWay}" /></TextBlock>
                    <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Note}" />
                    <StackPanel Margin="0,16,0,0">
                        <ui:Button HorizontalAlignment="Stretch" Appearance="Primary" Content="Update this application" Margin="0,0,0,6"
                                   Command="{Binding DataContext.UpdateSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   IsEnabled="{Binding CanUpdate}" AutomationProperties.Name="Update this application" />
                        <ui:Button HorizontalAlignment="Stretch" Content="Open Microsoft Store" Margin="0,0,0,6"
                                   Command="{Binding DataContext.OpenStoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   Visibility="{Binding IsStorePackage, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Open Microsoft Store" />
                        <ui:Button HorizontalAlignment="Stretch" Content="Exclude / restore" Margin="0,0,0,6"
                                   Command="{Binding DataContext.ToggleExcludeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   AutomationProperties.Name="Exclude or restore application" />
                        <ui:Button HorizontalAlignment="Stretch" Content="Skip this version"
                                   Command="{Binding DataContext.SkipVersionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   AutomationProperties.Name="Skip this version" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>
        </Grid>
    </Grid>
</UserControl>
