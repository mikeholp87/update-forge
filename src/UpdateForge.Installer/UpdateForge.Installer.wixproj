<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputName>UpdateForge-$(Version)-x64</OutputName>
    <Version Condition="'$(Version)' == ''">0.1.0</Version>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <AppPublishDir Condition="'$(AppPublishDir)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\publish\win-x64\</AppPublishDir>
    <DefineConstants>Version=$(Version);AppPublishDir=$(AppPublishDir)</DefineConstants>
    <!-- Per-user (no-admin) installs of file components trigger these ICE rules by design. -->
    <SuppressIces>ICE38;ICE60;ICE64;ICE91</SuppressIces>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" />
  </ItemGroup>
</Project>

